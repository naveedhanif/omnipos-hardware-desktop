# Standalone Hardware frontend: isolated read-only connection configuration.
# Copy this file to .env.local in THIS project, then replace placeholders privately.
# Used by /connection.html and the restricted Vercel functions after deployment.
# Opening the page makes no live call; sign-in requires explicit user consent.
# Never copy the OmniPOS .env file. Never add secret/service-role keys or passwords here.
# VITE_* values are PUBLIC in a browser build, even when stored in an ignored file.

# Approved existing OmniPOS BACKEND origin, not GitHub or the Supabase project URL.
# No trailing /api path. Confirm production/staging and the deployed revision separately.
VITE_OMNIPOS_API_ORIGIN=https://approved-omnipos-backend.example.invalid

# Same Supabase Auth project used by the existing backend.
VITE_SUPABASE_URL=https://existing-project.example.invalid
# Browser-safe key only. Name retained from OmniPOS; compatible publishable/legacy anon
# key type must be confirmed before SDK wiring. This key is NOT a user access token.
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_BROWSER_SAFE_CLIENT_KEY

# This app's origin. Use its real HTTPS production origin for deployment.
# Local development uses this exact origin; localhost is a different origin.
VITE_HARDWARE_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Supported mode: same-origin-proxy only.
# api/ functions forward only startup-context and page 1 / limit 10 products, stock balances or invoice GETs.
VITE_HARDWARE_TRANSPORT_MODE=same-origin-proxy

# Future email confirmation/recovery flows ONLY; routes are not implemented yet.
# Not needed for the first existing-account password sign-in + product-read check.
# Confirm actual frontend routes and auth redirect allow-list before filling/enabling.
VITE_HARDWARE_AUTH_CALLBACK_URL=
VITE_HARDWARE_AUTH_RECOVERY_URL=

# No live enable/posting flag is provided. Configuration confirmation and explicit
# approval of the live-call scope are separate from entering these values.
